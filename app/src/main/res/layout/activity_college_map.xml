<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#BFEBAD"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- PAGE TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗺️ College Battle Map"
            android:textColor="#28572D"
            android:textStyle="bold"
            android:textSize="24sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Explore residential college sustainability rankings"
            android:textColor="#456B47"
            android:textSize="14sp"
            android:layout_marginBottom="18dp" />

        <!-- INTERACTIVE OPENSTREETMAP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/eco_card"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌳 UM College Map"
                android:textColor="#28572D"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="12dp"
                android:gravity="center" />

            <org.osmdroid.views.MapView
                android:id="@+id/collegeMapView"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:contentDescription="Interactive map of UM residential colleges" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 Tap a college marker to view its location"
                android:textColor="#456B47"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <!-- MAP INFORMATION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/eco_card"
            android:padding="18dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏆 Current Leader"
                android:textStyle="bold"
                android:textColor="#28572D"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="KK12 — 4,200 Eco Points"
                android:textColor="#456B47"
                android:textSize="15sp"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total College Carbon Savings: 248.5 kg CO₂"
                android:textColor="#666666"
                android:textSize="13sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Demo data — live rankings will be integrated later."
                android:textColor="#777777"
                android:textSize="12sp"
                android:layout_marginTop="14dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
