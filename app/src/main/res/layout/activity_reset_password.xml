<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#C4EEB5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="45dp"
        android:paddingBottom="30dp">

        <!-- LOGO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌱"
            android:textSize="45sp"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <!-- APP NAME -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UM Ecoverse"
            android:textColor="#24543C"
            android:textStyle="bold"
            android:textSize="26sp"
            android:gravity="center" />

        <!-- TAGLINE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Small Actions, Big Impact"
            android:textColor="#3E7154"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="35dp" />

        <!-- WHITE CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="#FFFFFF"
            android:elevation="5dp">

            <!-- LOCK ICON -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔐"
                android:textSize="40sp"
                android:gravity="center"
                android:layout_marginBottom="15dp" />

            <!-- TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Forgot Password?"
                android:textColor="#24543C"
                android:textStyle="bold"
                android:textSize="23sp"
                android:gravity="center" />

            <!-- DESCRIPTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No worries! Enter your registered UM email address and we'll send you a link to reset your password."
                android:textColor="#7A857C"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="28dp" />

            <!-- EMAIL LABEL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="UM Email Address"
                android:textColor="#315C43"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <!-- EMAIL INPUT -->
            <EditText
                android:id="@+id/etResetEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="student@siswa.um.edu.my"
                android:textSize="13sp"
                android:singleLine="true"
                android:inputType="textEmailAddress"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:backgroundTint="#9DBA9D" />

            <!-- RESET BUTTON -->
            <Button
                android:id="@+id/btnSendResetLink"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:text="Send Reset Link"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#8BAA80" />

        </LinearLayout>

        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="For Universiti Malaya Students"
            android:textColor="#5E8264"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="28dp" />

    </LinearLayout>
</ScrollView>
