
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#BFEBAD"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#87A679"
            android:padding="22dp">
            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Back"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:padding="8dp"
                android:contentDescription="Go back"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎁 Rewards &amp; Challenges"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Turn your green actions into rewards!"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- POINTS CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/eco_card"
                android:padding="20dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="My Eco Points"
                    android:textColor="#456B47"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvRewardPoints"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="850 EP"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="#28572D"
                    android:layout_marginTop="5dp" />

                <TextView
                    android:id="@+id/tvRewardStreak"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔥 3-day streak • Reach 5 days for 1.5× points!"
                    android:textSize="12sp"
                    android:textColor="#456B47"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- REDEEM VOUCHERS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/eco_card"
                android:padding="18dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Redeem Your Rewards"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#28572D" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sample vouchers for the UM community"
                    android:textSize="12sp"
                    android:textColor="#777777"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="15dp" />

                <!-- VOUCHER 1 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="☕ RM5 Cafe Voucher"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#28572D" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="500 Eco Points"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginTop="5dp" />

                <Button
                    android:id="@+id/btnRedeemCafe"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Redeem Cafe Voucher"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#87A679"
                    android:layout_marginTop="10dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2EDE0"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp" />

                <!-- VOUCHER 2 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🍱 RM10 Foodcourt Voucher"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#28572D" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1,000 Eco Points"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginTop="5dp" />

                <Button
                    android:id="@+id/btnRedeemFoodcourt"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Redeem Foodcourt Voucher"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#87A679"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- ECO SPRINT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/eco_card"
                android:padding="18dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ Eco-Sprint Challenge"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#28572D" />

                <TextView
                    android:id="@+id/tvSprintTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Plastic-Free Campus Sprint"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#456B47"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:id="@+id/tvSprintTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Time remaining: 2 days 14 hours"
                    android:textSize="13sp"
                    android:textColor="#B36B22"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvSprintDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Complete 5 plastic recycling actions during this limited-time challenge."
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginTop="10dp" />

                <ProgressBar
                    android:id="@+id/progressSprint"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:max="5"
                    android:progress="2"
                    android:progressTint="#87A679"
                    android:layout_marginTop="15dp" />

                <TextView
                    android:id="@+id/tvSprintProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2 / 5 actions completed"
                    android:textSize="12sp"
                    android:textColor="#777777"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btnJoinSprint"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Join Eco-Sprint"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#87A679"
                    android:layout_marginTop="16dp" />
            </LinearLayout>

            <!-- BADGES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/eco_card"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="My Eco Badges"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#28572D" />

                <TextView
                    android:id="@+id/tvRewardBadges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌱 Eco Beginner     ♻️ Recycling Hero&#10;🏆 Sprint Champion (Locked)"
                    android:textSize="14sp"
                    android:textColor="#456B47"
                    android:lineSpacingExtra="10dp"
                    android:layout_marginTop="14dp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
